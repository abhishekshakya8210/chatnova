{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["email"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chat_rooms": {
      "$chatRoomId": {
        ".read": "auth != null && $chatRoomId.contains(auth.uid)",
        "messages": {
          "$messageId": {
            ".write": "auth != null && $chatRoomId.contains(auth.uid) && (!data.exists() && newData.child('senderId').val() === auth.uid || data.exists() && (data.child('receiverId').val() === auth.uid || data.child('senderId').val() === auth.uid))"
          }
        }
      }
    },
    "user_chats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatRoomId": {
          ".write": "auth != null && ($uid === auth.uid || $chatRoomId.contains(auth.uid))"
        }
      }
    }
  }
}
